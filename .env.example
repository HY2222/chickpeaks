# Copiad este archivo a .env y rellenad. Nunca subáis .env al repo.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_STT_MODEL=scribe_v1
# Claude (clave de la fase 1): lee documentos y reescribe en lectura fácil
ANTHROPIC_API_KEY=
# Opcional: modelo para leer documentos. Por defecto claude-haiku-5-5 (el más barato).
# Si Haiku lee mal las fotos buenas, poned claude-sonnet-5-5
WILLO_MODELO_DOCUMENTOS=
# Opcional: protege las herramientas de Noa (cabecera X-Willo-Token)
WILLO_TOOL_TOKEN=
# Opcional: fija la fecha de la demo (AAAA-MM-DD)
WILLO_HOY=
# Opcional: avisos por Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_DEMO=
# Opcional: teléfono de verdad de Javi para el botón "Llamar a Javi" (si no, usa el inventado)
WILLO_TELEFONO_JAVI=
