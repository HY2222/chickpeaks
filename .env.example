# Copiad este archivo a .env y rellenad. Nunca subáis .env al repo.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_STT_MODEL=scribe_v1
# Opcional: id de la voz de hombre que se puede elegir en "Voz de Noa"
ELEVENLABS_VOICE_ID_MASCULINA=
# Opcional: protege las herramientas de Noa (cabecera X-Willo-Token)
WILLO_TOOL_TOKEN=
# Opcional: fija la fecha de la demo (AAAA-MM-DD)
WILLO_HOY=
# Opcional: avisos por Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_DEMO=
